# englishchat.co.uk – Apache configuration (replaces the WordPress rules).
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS (the old site did too).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Old menu links pointed at /welcome#section – keep them working.
  RewriteRule ^welcome/?$ / [R=301,L]

  # Old WordPress image URLs -> new asset folder (only when the file exists).
  RewriteCond %{DOCUMENT_ROOT}/assets/img/$1 -f
  RewriteRule ^wp-content/uploads/(?:\d{4}/\d{2}/)?([^/]+)$ /assets/img/$1 [R=301,L]

  # Never serve dotfiles or the API bootstrap directly.
  RewriteRule (^|/)\. - [F]
  RewriteRule ^api/_init\.php$ - [F]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self \"https://js.stripe.com\")"
  <FilesMatch "\.(css|js|woff2|jpe?g|png|gif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
